# ── Security headers (2026-07-28 security review) ────────────────────────────
# HSTS is emitted only when the request actually arrived over https, so a
# plain-HTTP deployment (local dev behind NPM, a bring-up before certs land)
# is never pinned. `map` is valid here because conf.d/*.conf is included
# inside nginx's http{} block. NGINX_HSTS_MAX_AGE is substituted by
# frontend/docker-entrypoint.sh (default 31536000; set 0 to disable, which
# also clears an existing pin).
#
# The header list itself lives in /etc/nginx/security-headers.conf and is
# included at server level AND in every location that sets its own
# add_header — nginx replaces, rather than merges, inherited headers.
map $http_x_forwarded_proto $insula_hsts {
    default "";
    https   "max-age=${NGINX_HSTS_MAX_AGE}";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers (CSP frame-ancestors, XFO, nosniff, Referrer-Policy,
    # HSTS). The admin panel EMBEDS Stalwart's web-admin / Longhorn in
    # iframes; frame-ancestors governs who may embed THIS panel, so 'self'
    # does not affect those children.
    include /etc/nginx/security-headers.conf;


    # Re-resolve upstream on each request so a recreated pod doesn't leave
    # us pointing at a dead IP.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream  http://${BACKEND_HOST}:${BACKEND_PORT};

    # Trust X-Forwarded-For from in-cluster proxies (Traefik DS pod is
    # our immediate TCP peer, RFC1918 pod CIDR) so $remote_addr resolves
    # to the real client IP from the XFF chain rather than the Traefik
    # pod IP. Without this, the X-Real-IP we forward to platform-api is
    # the Traefik pod IP — breaking CrowdSec L4 enforcement guard, audit
    # logs, and any other src-IP-aware backend logic.
    # Covers default k3s pod CIDR (10.42.0.0/16) + svc CIDR
    # (10.43.0.0/16) + RFC1918 + IPv6 ULA.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from fd00::/8;
    # Operator-managed trusted-proxy CIDRs (CDN/LB/floating-IP ranges
    # added via /nodes-and-storage → Trusted Proxies tab). The
    # cluster-trusted-proxy-reconciler materialises a ConfigMap that's
    # mounted here as a directory; each entry becomes one *.conf file
    # containing additional `set_real_ip_from <cidr>;` lines. Empty
    # directory (no operator entries) is valid — glob include yields
    # zero files and nginx starts cleanly.
    include /etc/nginx/conf.d/trusted-proxies.d/*.conf;
    real_ip_header X-Forwarded-For;
    # Recursive so a chain "client, lb-pod, traefik-pod" yields the
    # leftmost non-trusted entry as $remote_addr (= the real client).
    real_ip_recursive on;

    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
        # Re-include: this location sets its own add_header, which makes
        # nginx DISCARD the server-level set.
        include /etc/nginx/security-headers.conf;
    }

    # ─── Internal API — never reachable from the public panel ────────────
    # M6: the /api/v1/internal/* routes are for in-cluster callers only
    # (sftp-gateway, tenant backup/restore Jobs, the Stalwart init container)
    # which reach platform-api via its ClusterIP Service directly, NOT via
    # this nginx. They are gated by X-Internal-Auth / HMAC tokens, but one
    # (stalwart-data-expectation) is anonymous, so refuse the whole prefix at
    # the edge. A more-specific location wins over /api/v1/ below.
    location ^~ /api/v1/internal/ {
        return 404;
    }

    # ─── Platform API ───────────────────────────────────────────────────
    location /api/v1/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Strip Accept-Encoding so platform-api sends plain JSON; nginx
        # re-compresses on the way out per the gzip directive below.
        # Without this, double-gzip truncated body to content-length:0
        # on every authenticated admin API write. Caught by
        # integration-oidc-dex on testing.example.test 2026-05-16.
        proxy_set_header Accept-Encoding "";
        # WebSocket support (log streaming, terminal)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Uploads bounded by tenant PVC quota, not nginx.
        client_max_body_size 0;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_request_buffering off;
    }

    # Email autodiscover endpoints
    location /.well-known/autoconfig/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/[Aa]utodiscover/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /.well-known/mta-sts.txt {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Runtime config MUST NOT be cached. It is re-rendered on every pod
    # start (envsubst over config.template.js) and we explicitly want
    # operators to see changes to e.g. LONGHORN_URL on the next page
    # load, not after a browser cache purge. `no-store` beats the
    # 30-day static-asset rule below because a more specific location
    # block wins in nginx.
    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        # Re-include: this location sets its own add_header, which makes
        # nginx DISCARD the server-level set.
        include /etc/nginx/security-headers.conf;
        add_header Pragma "no-cache" always;
        expires 0;
        try_files $uri =404;
    }

    # SPA: all other routes fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        # Re-include: this location sets its own add_header, which makes
        # nginx DISCARD the server-level set.
        include /etc/nginx/security-headers.conf;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
}
