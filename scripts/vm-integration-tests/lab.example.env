# scripts/vm-integration-tests/lab.example.env — the retained local VM lab (lab.sh).
#
# Copy to lab.env (git-ignored) and adjust. lab.sh also sources config.env for the
# shared driver settings (VMTEST_DRIVER, VMTEST_HOST_SSH, pools, registry mirror).
# Design: docs/development/LOCAL_VM_LAB.md.

# The lab's private apex. Clusters live under it (dev.<apex>, stg.<apex>); the
# shared services VM answers for it (ca.<apex>, s3.<apex>, …). Point the LAN
# resolver's conditional forwarding for this name at LAB_SVC_IP.
LAB_APEX="${LAB_APEX:-lab.example.test}"

# Routed libvirt networks (no NAT on the host). The LAN router needs a static route
# for the enclosing range (e.g. 10.98.0.0/16) to the VM host and NATs it outward.
# Third octets 100+ stay clear of the throw-away tier's 10.98.<1..90> run networks.
LAB_SVC_NET="${LAB_SVC_NET:-10.98.100}"     # services VM + runner
LAB_DEV_NET="${LAB_DEV_NET:-10.98.110}"     # local DEV (1 node)
LAB_STG_NET="${LAB_STG_NET:-10.98.120}"     # local staging (3 servers + optional worker)

# Upstream resolver for everything outside LAB_APEX (the svc dnsmasq forwards to it).
LAB_UPSTREAM_DNS="${LAB_UPSTREAM_DNS:-1.1.1.1}"

# Sizes (vCPU / MiB RAM / GiB disk).
LAB_SVC_VCPU="${LAB_SVC_VCPU:-2}";      LAB_SVC_RAM_MB="${LAB_SVC_RAM_MB:-2048}";       LAB_SVC_DISK_GB="${LAB_SVC_DISK_GB:-30}"
LAB_RUNNER_VCPU="${LAB_RUNNER_VCPU:-2}"; LAB_RUNNER_RAM_MB="${LAB_RUNNER_RAM_MB:-2048}"; LAB_RUNNER_DISK_GB="${LAB_RUNNER_DISK_GB:-20}"
LAB_DEV_VCPU="${LAB_DEV_VCPU:-6}";      LAB_DEV_RAM_MB="${LAB_DEV_RAM_MB:-12288}";      LAB_DEV_DISK_GB="${LAB_DEV_DISK_GB:-80}"
LAB_STG_VCPU="${LAB_STG_VCPU:-4}";      LAB_STG_RAM_MB="${LAB_STG_RAM_MB:-8192}";       LAB_STG_DISK_GB="${LAB_STG_DISK_GB:-60}"
LAB_STG_SERVERS="${LAB_STG_SERVERS:-3}"

# Cluster nodes run a RANDOM supported OS each (lib/os-registry.sh), drawn once when the
# VM is created and kept for its life (recorded in LAB_STATE_FILE) — a mixed cluster, as
# real installs grow node by node. Empty pool = every supported OS with a pinned image.
# LAB_NODE_OS pins every NEW node to one OS instead.
LAB_NODE_OS_POOL="${LAB_NODE_OS_POOL:-}"
LAB_NODE_OS="${LAB_NODE_OS:-}"
# The services VM and the runner are infrastructure: one fixed OS.
LAB_INFRA_OS="${LAB_INFRA_OS:-debian-13}"

# Host memory that must stay available after a cluster's ceilings are added.
LAB_MEM_MARGIN_MB="${LAB_MEM_MARGIN_MB:-8192}"

# Credentials and coordinates the lab generates once (0600). Never committed.
LAB_STATE_FILE="${LAB_STATE_FILE:-$HOME/.config/insula/lab-state.env}"

# Extra node-scoped bootstrap.sh flags for every lab install (optional).
LAB_BOOTSTRAP_EXTRA_ARGS="${LAB_BOOTSTRAP_EXTRA_ARGS:-}"
