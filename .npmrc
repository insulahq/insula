# npm policy for the workspace root (applies to every workspace).
#
# ignore-scripts — do not execute dependency lifecycle scripts on install.
#
# WHY: a package's `preinstall`/`install`/`postinstall` runs with the full
# privileges of whoever ran `npm ci` — in CI that means the runner's registry
# credentials, GHCR push token and checkout. It is the primary execution vector
# for the npm worm compromises (Shai-Hulud, the 2026-08 keyv/@adminide-stack
# wave): the malicious code runs on INSTALL, so you are hit without ever
# importing the package, and a transitive dependency you have never heard of is
# enough. Disabling scripts turns "one compromised transitive dep owns CI" into
# "a compromised dep sits inert on disk".
#
# The Dockerfiles already pass --ignore-scripts explicitly, so shipped images
# were covered; this closes the same hole for CI runners and developer machines.
#
# VERIFIED SAFE, not assumed — the whole monorepo was installed with this flag
# and exercised end to end (2026-08-06):
#   npm ci                      834 packages, exit 0
#   api-contracts / backend     build + tsc --noEmit clean
#   ui-restore-cart             build clean
#   admin-panel / tenant-panel  vite build clean (esbuild needs no postinstall)
#   bcrypt                      hash + compare OK  (native, runtime auth)
#   ssh2                        loads OK           (native, SFTP gateway)
#   backend unit tests          5978 passed, 0 failed
#
# Only 9 packages in the tree declare install scripts and none of them needs to
# run: bcrypt and esbuild ship prebuilt platform binaries, fsevents is macOS
# only, cpu-features is an optional ssh2 accelerator. If a future dependency
# genuinely requires its script, rebuild THAT package explicitly
# (`npm rebuild <pkg>`) rather than re-enabling scripts for all 800+.
ignore-scripts=true
